# ═══════════════════════════════════════════════════════════════════════════════
# TourMate React Web Application — Environment Variables Template
# Copy this file to .env and fill in your actual keys.
# DO NOT commit .env with real secrets to GitHub.
# ═══════════════════════════════════════════════════════════════════════════════

# Google Maps JavaScript API Key
VITE_GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# Backend REST API URL (Default: http://localhost:5000/api/v1)
VITE_API_URL=http://localhost:5000/api/v1
