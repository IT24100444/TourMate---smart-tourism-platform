# ═══════════════════════════════════════════════════════════════════════════════
# TourMate AI Subsystem — Environment Configuration Template
# For production deployment on Railway, set these in the Railway Variables tab.
# ═══════════════════════════════════════════════════════════════════════════════

# 1. Google Gemini / GenAI Credentials (REQUIRED)
# Obtain from Google AI Studio: https://aistudio.google.com/app/apikey
GOOGLE_API_KEY=your_gemini_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here

# Set to False when using standard Gemini API key (True if using Google Cloud Vertex AI)
GOOGLE_GENAI_USE_VERTEXAI=False

# Model selection (default: gemini-3.5-flash-lite)
GEMINI_MODEL=gemini-3.5-flash-lite

# 2. Database & Persistence Configuration (OPTIONAL)
# If provided, connects to PostgreSQL; if omitted, automatically falls back to local SQLite
# DATABASE_URL=postgresql://user:password@host:port/dbname?sslmode=require

# 3. Server Networking Configuration
# Railway injects PORT automatically at runtime
PORT=8000
HOST=0.0.0.0

# 4. CORS Origins (Default: allow all)
ALLOW_ORIGINS=*

# 5. Live Web Search Tool Fallback (OPTIONAL)
# TAVILY_API_KEY=tvly-your_api_key_here
